includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

rules:
    - CuyZ\ValinorBundle\Tests\QA\ApiAndInternalAnnotationCheck

parameters:
    level: max
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/test/default/CuyZ_ValinorBundle_Tests_App_AppKernelTestDebugContainer.xml
    scanDirectories:
        - vendor/symfony/dependency-injection/Loader/Configurator
    tmpDir: var/cache/phpstan
    ignoreErrors:
        # Although PHPStan has a quite strong purity inferring mechanism, some
        # caveats remain and make it really hard to properly add `@pure` markers
        # all over the codebase. For this reason, we suppress these errors.
        -   identifier: possiblyImpure.methodCall
